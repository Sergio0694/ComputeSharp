<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup>

    <!--
      Ignore some warnings about ambiguous cref attribute references. These are because the assembly defines
      blittable bindings for several ABI types from Win2D, in the same namespace as the ABI types from the
      CsWinRT projections that are in Win2D. They are internal, but Roslyn will still complain about them.
    -->
    <NoWarn>$(NoWarn);CS0419</NoWarn>

    <!-- Ignore warnings for usings outside of a namespace (needed for some WinRT type aliases) -->
    <NoWarn>$(NoWarn);IDE0065</NoWarn>

    <!--
      This project is a class library, so it only compiles against the Win2D API surface (which is resolved
      from the reference assembly in the 'lib' folder of the package). It never needs to resolve the native
      'Microsoft.Graphics.Canvas.dll', as that is the responsibility of the consuming application, which
      still gets the Win2D build logic transitively. That is also why the library is packed as 'AnyCPU', so
      that it can be consumed from any architecture. Opt out of the Win2D check assuming an application
      build, which would otherwise warn that no specific platform has been set.
    -->
    <Win2DWarnNoPlatform>false</Win2DWarnNoPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ComputeSharp.D2D1\ComputeSharp.D2D1.csproj" />
  </ItemGroup>

  <Import Project="..\ComputeSharp.D2D1.UI\ComputeSharp.D2D1.UI.projitems" Label="Shared" />
</Project>
